# Local UAT credentials for the opt-in integration suite (spec/integration).
#
# Copy this file to `.env` (which is git-ignored) and fill in a UAT key issued
# from the merchant dashboard. These values are read ONLY by the integration
# specs in THIS repository — never commit real credentials.
#
#   cp .env.example .env
#   BML_RUN_UAT=1 bundle exec rspec spec/integration
#
# The suite runs live against BML (it creates real customer records), so it
# only fires when BML_RUN_UAT is set AND a key is present. Without that,
# `bundle exec rspec` skips integration cleanly and the deterministic
# unit/contract suites need none of this.

# Raw BML API key (no "Bearer" prefix). Rejected keys return PP-C-004.
# Either name works; MPG_API_KEY is what this repo's .env already uses.
BML_API_KEY=
# MPG_API_KEY=

# The App ID associated with the key (audit "who" default). Optional — the key
# (a JWT) already encodes appId, and BML authenticates on the key alone.
BML_APP_ID=

# Environment to exercise: sandbox (UAT) or production. Keep this on sandbox.
BML_ENV=sandbox

# Explicit opt-in to run the live UAT suite. Unset = integration skips.
BML_RUN_UAT=
